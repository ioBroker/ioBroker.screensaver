{
  "name": "iobroker.screensaver",
  "version": "0.1.0",
  "description": "ioBroker photo frame and screensaver: widgets for vis-2, web components for devices, albums from folders and Immich",
  "author": "bluefox <dogafox@gmail.com>",
  "contributors": [
    "bluefox <dogafox@gmail.com>"
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.screensaver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.screensaver"
  },
  "keywords": [
    "ioBroker",
    "photo frame",
    "slideshow",
    "screensaver",
    "immich",
    "vis-2",
    "web components"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@iobroker/vis-2-widgets-testing": "^2.0.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "files": [
    "admin/",
    "build/",
    "widgets/",
    "docker-compose.yaml",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.build.json --noEmit && cd src-widgets && tsc",
    "test:unit": "tsx --test \"src/**/*.test.ts\" \"src-widgets/src/**/*.test.ts\"",
    "test:package": "mocha test/package.test.js --exit",
    "test:integration": "mocha test/widgets.test.js --exit",
    "prepublishOnly": "npm run build",
    "lint": "eslint -c eslint.config.mjs",
    "build": "tsx tasks.ts",
    "test": "mocha ./test/*.test.js",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-widgets && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-widgets && npm i -f",
    "widget-0-clean": "tsx tasks.ts --widget-0-clean",
    "widget-1-npm": "tsx tasks.ts --widget-1-npm",
    "widget-2-compile": "tsx tasks.ts --widget-2-compile",
    "widget-3-copy": "tsx tasks.ts --widget-3-copy",
    "widget-4-webcomponents": "tsx tasks.ts --widget-4-webcomponents",
    "build:backend": "tsx tasks.ts --backend"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.screensaver/issues"
  },
  "readmeFilename": "README.md",
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/plugin-docker": "^1.3.1",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.5"
  },
  "main": "build/src/main.js",
  "engines": {
    "node": ">=20.9.0"
  }
}
